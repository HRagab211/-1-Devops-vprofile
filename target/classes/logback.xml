<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration>
<configuration>

	<appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>%date{HH:mm:ss.SSS} [%thread] %-5level %logger{15}#%line %msg%n</pattern>
		</encoder>
	</appender>

	<!-- Turn off all logging for specific packages.
	     Levels are env-overridable (logback resolves ${VAR:-default} from system properties
	     and then the OS environment). With no variables set the behaviour is unchanged: OFF.
	     The container lab sets LOG_LEVEL/SPRING_LOG_LEVEL=INFO so logs reach stdout. -->
	<logger name="com.visualpathit.account" level="${APP_LOG_LEVEL:-OFF}" />
	<logger name="org.springframework" level="${SPRING_LOG_LEVEL:-OFF}" />
	<logger name="org.hibernate" level="${HIBERNATE_LOG_LEVEL:-OFF}" />
	<logger name="org.hibernate.SQL" level="${HIBERNATE_SQL_LOG_LEVEL:-OFF}" />
	<logger name="org.hibernate.type" level="${HIBERNATE_TYPE_LOG_LEVEL:-OFF}" />

	<!-- Root logging configuration -->
	<root level="${LOG_LEVEL:-OFF}">
		<appender-ref ref="STDOUT" />
	</root>

</configuration>
