# vprofile container lab -- example environment.
#
#   cp .env.example .env
#
# .env is gitignored and dockerignored. NEVER commit a real .env, and never bake these
# values into the application image -- they are injected at run time only.
#
# Everything here has a safe in-file default in compose.yaml, so `docker compose up -d`
# works with no .env at all. Copy the file when you want to change something.
#
# These are LAB credentials. They match the defaults already committed in
# src/main/resources/application.properties and src/main/resources/db_backup.sql so the
# stack is reproducible out of the box. Replace every one of them for anything real.

# ---------------------------------------------------------------------------
# MySQL (service: db, network alias: db01)
# ---------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=admin123
# Must stay "accounts": db_backup.sql has no CREATE DATABASE/USE statement, so the MySQL
# entrypoint supplies the schema by running init files with --database="$MYSQL_DATABASE".
MYSQL_DATABASE=accounts
MYSQL_USER=admin
MYSQL_PASSWORD=admin123

# ---------------------------------------------------------------------------
# RabbitMQ (service: rabbitmq, network alias: rmq01)
# ---------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=test
RABBITMQ_DEFAULT_PASS=test

# ---------------------------------------------------------------------------
# Application -> backing services
# These map onto the ${ENV:default} placeholders in application.properties.
# Hostnames are Compose service names; db01/mc01/rmq01 also resolve as network aliases.
# ---------------------------------------------------------------------------
JDBC_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver
JDBC_URL=jdbc:mysql://db:3306/accounts?useUnicode=true&characterEncoding=UTF-8&zeroDateTimeBehavior=convertToNull
JDBC_USERNAME=admin
JDBC_PASSWORD=admin123

MEMCACHED_HOST=cache
MEMCACHED_PORT=11211
MEMCACHED_STANDBY_HOST=cache
MEMCACHED_STANDBY_PORT=11211

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=test
RABBITMQ_PASSWORD=test

# ---------------------------------------------------------------------------
# Elasticsearch is NOT deployed by this stack -- ElasticSearchController builds its client
# per request and nothing needs it at startup (see docs/container-lab.md). The keys must
# still resolve because Components.java @Value has no defaults. Point them at a real
# cluster only if you deliberately want /user/elasticsearch to work.
# ---------------------------------------------------------------------------
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_CLUSTER=vprofile
ELASTICSEARCH_NODE=vprofilenode

# ---------------------------------------------------------------------------
# Logging. logback.xml defaults every level to OFF; the lab raises it so container logs
# are useful. Valid values: OFF ERROR WARN INFO DEBUG TRACE.
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO
SPRING_LOG_LEVEL=INFO
HIBERNATE_LOG_LEVEL=WARN

# ---------------------------------------------------------------------------
# Host port publishing and image tag
# ---------------------------------------------------------------------------
NGINX_HTTP_PORT=80
RABBITMQ_MGMT_PORT=15672
APP_IMAGE_TAG=vprofile-app:lab

# Bounded startup wait performed by the app container before Tomcat starts.
WAIT_FOR_TCP=db:3306 rabbitmq:5672 cache:11211
WAIT_FOR_TIMEOUT=90
